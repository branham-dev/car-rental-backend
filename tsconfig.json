{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "types": [
      "node"
    ],

    "outDir": "./dist",
    "allowArbitraryExtensions": true,

		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
		},
  },
  "include": ["src"],
  "exclude": ["node_modules"],
}
